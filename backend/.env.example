DB_URL=url-goes-here
DB_USER=-user-goes-here
DB_PASSWORD=postgres-password-goes-here

# optional locally (these are the defaults). set them on the real server:
# where the React app lives, e.g. https://ledjr.dev
FRONTEND_ORIGIN=http://localhost:5173
# true once the site is on https
COOKIE_SECURE=false

# real emails (forgot password). leave empty locally and they get printed in the backend log instead
RESEND_API_KEY=
MAIL_FROM=Ledjr <no-reply@ledjr.dev>
# true ONLY behind Heroku's router (reads the real IP from X-Forwarded-For). leave false locally
TRUST_PROXY=false
